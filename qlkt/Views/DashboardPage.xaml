<UserControl x:Class="QLKT.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource Brush.Background}">

        <StackPanel Margin="{StaticResource Spacing.LG}">

            <!-- ================= TITLE ================= -->
            <TextBlock Text="Tổng quan hệ thống"
                       Style="{StaticResource Text.Heading.Large}"
                       Margin="0,0,0,16"/>

            <!-- ================= KPI CARDS ================= -->
            <WrapPanel Margin="0,0,0,16">

                <!-- Card 1 -->
                <Border Style="{StaticResource Card.KPI}">
                    <StackPanel>

                        <TextBlock Text="Tổng khen thưởng"
                                   Style="{StaticResource Text.Label}"/>

                        <TextBlock x:Name="txtTotalRewards" Text="0"
                                   Style="{StaticResource Text.Heading.Medium}"/>

                        <TextBlock Text="+12% so với tháng trước"
                                   Style="{StaticResource Text.Caption}"/>

                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Style="{StaticResource Card.KPI}">
                    <StackPanel>

                        <TextBlock Text="Đang chờ duyệt"
                                   Style="{StaticResource Text.Label}"/>

                        <TextBlock x:Name="txtPendingRewards" Text="0"
                                   Style="{StaticResource Text.Heading.Medium}"/>

                        <TextBlock Text="Cần xử lý"
                                   Style="{StaticResource Text.Warning}"/>

                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Style="{StaticResource Card.KPI}">
                    <StackPanel>

                        <TextBlock Text="Tổng quân nhân"
                                   Style="{StaticResource Text.Label}"/>

                        <TextBlock x:Name="txtTotalSoldiers" Text="0"
                                   Style="{StaticResource Text.Heading.Medium}"/>

                        <TextBlock Text="Ổn định"
                                   Style="{StaticResource Text.Success}"/>

                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- ================= CHART ================= -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Thống kê khen thưởng"
                               Style="{StaticResource Text.Heading.Small}"
                               Margin="0,0,0,12"/>

                    <!-- Placeholder Chart -->
                    <Border Height="200"
                            Background="{StaticResource Brush.Surface.Hover}"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch">

                        <TextBlock Text="Chart Placeholder"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"/>

                    </Border>

                </StackPanel>

            </Border>

            <!-- ================= TABLE ================= -->
            <Border Style="{StaticResource Card}">

                <StackPanel>

                    <!-- Header -->
                    <DockPanel Margin="0,0,0,12">

                        <TextBlock Text="Danh sách khen thưởng gần đây"
                                   Style="{StaticResource Text.Heading.Small}"
                                   DockPanel.Dock="Left"/>

                        <Button Content="Xem tất cả"
                                Style="{StaticResource Button}"
                                Tag="Secondary"
                                DockPanel.Dock="Right"/>

                    </DockPanel>

                    <!-- DataGrid -->
                    <DataGrid Style="{StaticResource DataGrid}"
                              AutoGenerateColumns="False"
                              Height="300">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Cấp bậc"
                                                Binding="{Binding Rank}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Đơn vị"
                                                Binding="{Binding Unit}"
                                                Width="200"/>

                            <DataGridTextColumn Header="Ngày"
                                                Binding="{Binding Date}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding Status}"
                                                Width="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
