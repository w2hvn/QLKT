<UserControl x:Class="QLKT.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{StaticResource Brush.Background}">

        <StackPanel Margin="24">

            <!-- ================= KPI CARDS ================= -->
            <WrapPanel Margin="0,0,0,24">

                <!-- Card 1: Total Soldiers -->
                <Border Style="{StaticResource Card.KPI}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" Background="#E6F7FF" CornerRadius="25" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tổng quân số" Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="txtTotalSoldiers" Text="1,280" Style="{StaticResource Text.Heading.Medium}"/>
                            <TextBlock Text="+2% so với tháng trước" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Total Rewards -->
                <Border Style="{StaticResource Card.KPI}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" Background="#FFF7E6" CornerRadius="25" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="🏅" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tổng khen thưởng" Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="txtTotalRewards" Text="456" Style="{StaticResource Text.Heading.Medium}"/>
                            <TextBlock Text="+12% so với tháng trước" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 3: Pending -->
                <Border Style="{StaticResource Card.KPI}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="50" Height="50" Background="#FFF1F0" CornerRadius="25" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Đang chờ duyệt" Style="{StaticResource Text.Label}"/>
                            <TextBlock x:Name="txtPendingRewards" Text="15" Style="{StaticResource Text.Heading.Medium}"/>
                            <TextBlock Text="Cần xử lý ngay" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Danger}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </WrapPanel>

            <!-- ================= RECENT REWARDS TABLE ================= -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,20">
                        <TextBlock Text="Khen thưởng gần đây" Style="{StaticResource Text.Heading.Small}" DockPanel.Dock="Left"/>
                        <Button Content="Xem tất cả" Style="{StaticResource Button}" Tag="Secondary" DockPanel.Dock="Right" Padding="12,4"/>
                    </DockPanel>

                    <DataGrid Style="{StaticResource DataGrid}"
                              AutoGenerateColumns="False"
                              Height="400"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Cấp bậc" Binding="{Binding Rank}" Width="150"/>
                            <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="200"/>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="150"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#E6F7FF" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="#1890FF" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
