<UserControl x:Class="MilitaryRewardApp.Views.UnitManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: TreeView -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,10,0">
            <TreeView x:Name="tvUnits" SelectedItemChanged="tvUnits_SelectedItemChanged"/>
        </Border>

        <!-- Right: Actions -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="Quản lý đơn vị" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Tên đơn vị:"/>
            <TextBox x:Name="txtUnitName"/>
            
            <TextBlock Text="Đơn vị cấp trên (ID):"/>
            <TextBox x:Name="txtParentID" IsReadOnly="True" Background="#F0F0F0"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Thêm Gốc" Click="AddRoot_Click" Margin="0,0,10,0" Width="100"/>
                <Button Content="Thêm Con" Click="AddChild_Click" Margin="0,0,10,0" Width="100"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Cập nhật" Click="Update_Click" Margin="0,0,10,0" Width="100"/>
                <Button Content="Xóa" Click="Delete_Click" Background="Red" Foreground="White" Width="100"/>
            </StackPanel>
            
            <TextBlock Text="* Chọn một đơn vị trong cây để Thêm Con, Sửa hoặc Xóa." 
                       Foreground="Gray" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
