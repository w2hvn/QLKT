<UserControl x:Class="QLKT.Views.ReportManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- Filters & Columns -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Tổng số quyết định" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"/>
                    <TextBlock x:Name="txtTotalDecisions" Text="0" Style="{StaticResource Text.Heading.Medium}" Foreground="{StaticResource Brush.Primary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Khen thưởng tháng này" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"/>
                    <TextBlock x:Name="txtMonthlyRewards" Text="0" Style="{StaticResource Text.Heading.Medium}" Foreground="Green" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Số đơn vị được khen thưởng" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Muted}"/>
                    <TextBlock x:Name="txtTotalUnits" Text="0" Style="{StaticResource Text.Heading.Medium}" Foreground="{StaticResource Brush.Gold}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filters & DataGrid container -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="White" CornerRadius="8" Padding="24">
            <Border.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,24,12">
                        <TextBlock Text="Đơn vị:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboUnitFilter" Width="180" DisplayMemberPath="UnitName" SelectedValuePath="UnitID"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,12">
                        <TextBlock Text="Từ ngày:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpFrom" Width="140"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,12">
                        <TextBlock Text="Đến ngày:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpTo" Width="140"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,24,12">
                        <TextBlock Text="Loại khen thưởng:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cboRewardType" Width="180">
                            <ComboBoxItem Content="Tất cả"/>
                            <ComboBoxItem Content="Huân chương"/>
                            <ComboBoxItem Content="Huy chương"/>
                            <ComboBoxItem Content="Bằng khen"/>
                            <ComboBoxItem Content="Giấy khen"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Content="Tạo báo cáo" Style="{StaticResource Button}" Click="Generate_Click" Margin="0,0,12,12" VerticalAlignment="Bottom"/>
                    <Button Content="Xuất Excel" Style="{StaticResource Button}" Background="Green" Foreground="White" Click="Export_Click" Margin="0,0,12,12" VerticalAlignment="Bottom"/>
                    <ToggleButton x:Name="btnToggleCharts" Content="Hiển thị Biểu đồ" Style="{StaticResource Button}" Tag="Secondary" Margin="0,0,0,12" VerticalAlignment="Bottom"/>
                </WrapPanel>

                <!-- Dynamic Columns -->
                <Expander Grid.Row="1" Header="Chọn trường dữ liệu hiển thị" Margin="0,0,0,16">
                    <WrapPanel Margin="8">
                        <CheckBox x:Name="chkCode" Content="Mã quân nhân" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkName" Content="Họ tên" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkRank" Content="Cấp bậc" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkUnit" Content="Đơn vị" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkPos" Content="Chức vụ" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkReward" Content="Hình thức khen thưởng" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkReason" Content="Lý do khen thưởng" IsChecked="True" Margin="0,0,15,8"/>
                        <CheckBox x:Name="chkDate" Content="Ngày quyết định" IsChecked="True" Margin="0,0,15,8"/>
                    </WrapPanel>
                </Expander>

                <!-- Preview & Charts -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgReport" Style="{StaticResource DataGrid}" AutoGenerateColumns="True" IsReadOnly="True"/>

                    <!-- Advanced Charts Panel -->
                    <Border Grid.Column="1" Width="400" Margin="16,0,0,0" Background="#F8F9FA" CornerRadius="8" Padding="16"
                            Visibility="{Binding IsChecked, ElementName=btnToggleCharts, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer>
                            <StackPanel>
                                <TextBlock Text="PHÂN TÍCH DỮ LIỆU" FontWeight="Bold" Margin="0,0,0,16"/>

                                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Xu hướng Đề xuất vs Phê duyệt" FontSize="12" Margin="0,0,0,8"/>
                                        <ContentControl x:Name="chartTrend" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Phân bổ theo loại khen thưởng" FontSize="12" Margin="0,0,0,8"/>
                                        <ContentControl x:Name="chartDistribution" Height="150"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Top đơn vị tiêu biểu" FontSize="12" Margin="0,0,0,8"/>
                                        <ContentControl x:Name="chartUnits" Height="150"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
