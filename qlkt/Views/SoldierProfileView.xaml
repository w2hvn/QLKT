<UserControl x:Class="QLKT.Views.SoldierProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Cards Section -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Card -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="0,0,0,20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Top Background Color -->
                        <Border Height="100" Background="#001529" CornerRadius="8,8,0,0"/>
                        <!-- Avatar -->
                        <Border Width="120" Height="120" CornerRadius="60" Margin="0,-60,0,10" Background="White" BorderBrush="White" BorderThickness="4">
                            <Ellipse Width="112" Height="112">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#E0E0E0"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <!-- Fallback Avatar text inside ellipse if needed -->
                        <TextBlock Text="👨‍✈️" FontSize="50" HorizontalAlignment="Center" Margin="0,-115,0,50" Foreground="Gray" RenderTransformOrigin="0.5,0.5"/>

                        <TextBlock x:Name="txtFullName" Text="Đặng Văn Tú" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                        <TextBlock x:Name="txtRank" Text="Trung tá" FontSize="16" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Info Card -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Thông tin cá nhân" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID" Foreground="#666666"/>
                            <TextBlock x:Name="txtSoldierCode" Grid.Column="1" Text="SQ001" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dân tộc" Foreground="#666666"/>
                            <TextBlock x:Name="txtEthnicity" Grid.Column="1" Text="Kinh" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tôn giáo" Foreground="#666666"/>
                            <TextBlock x:Name="txtReligion" Grid.Column="1" Text="Không" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rank & Unit Card -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cấp bậc &amp; Đơn vị" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <TextBlock Text="Cấp bậc hiện" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtRank2" Text="Trung tá" Margin="0,0,0,12"/>

                        <TextBlock Text="Đơn vị" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtUnit" Text="Sư đoàn 301" Margin="0,0,0,12"/>

                        <TextBlock Text="Chức vụ" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtPosition" Text="Cán bộ"/>
                    </StackPanel>
                </Border>

                <!-- Achievements Card -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Margin="0,0,0,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Thành tích" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Đang chờ" HorizontalAlignment="Right" Foreground="#001529" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="Tổng ký khay thành tích" Margin="0,0,0,8"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="• Chiến sĩ vẻ vang" Margin="0,0,0,4"/>
                            <TextBlock Text="• Thành tích Huân chương Chiến công hạng 3" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="• Hiện còn quỹ thái hàng" Margin="0,0,0,4"/>
                        </StackPanel>
                        <TextBlock Text="Những khát lạ v" HorizontalAlignment="Right" Foreground="#666666" Margin="0,10,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Timeline Section -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,30">
                        <TextBlock Text="Timeline Khen thưởng" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        <ComboBox Width="200" HorizontalAlignment="Right">
                            <ComboBoxItem IsSelected="True">Lọc theo trạng thái Khen thưởng</ComboBoxItem>
                        </ComboBox>
                    </Grid>

                    <!-- Custom Timeline Visualization -->
                    <Grid Height="150" Margin="20,0">
                        <!-- Horizontal Line -->
                        <Line X1="0" Y1="30" X2="1000" Y2="30" Stroke="#001529" StrokeThickness="2" VerticalAlignment="Top"/>
                        <Polygon Points="1000,25 1010,30 1000,35" Fill="#001529" VerticalAlignment="Top"/>

                        <!-- Item 1 -->
                        <Canvas Margin="30,0,0,0">
                            <TextBlock Text="15/06/2018" Canvas.Top="5" Foreground="#666666"/>
                            <Line X1="35" Y1="30" X2="35" Y2="50" Stroke="#001529" StrokeThickness="2"/>
                            <!-- Icon/Box -->
                            <Border Canvas.Top="55" Canvas.Left="0" Width="40" Height="40" Background="#FFF7E6" BorderBrush="#FFD591" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="📜" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <StackPanel Canvas.Top="55" Canvas.Left="50" Width="200">
                                <TextBlock Text="Nhận Bằng khen" FontWeight="Bold"/>
                                <TextBlock Text="Nhận thưởng Nhận Bằng Chiến công thành tích và" TextWrapping="Wrap" Foreground="#666666" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Canvas>

                        <!-- Item 2 -->
                        <Canvas Margin="350,0,0,0">
                            <TextBlock Text="10/01/2020" Canvas.Top="5" Foreground="#666666"/>
                            <Line X1="35" Y1="30" X2="35" Y2="50" Stroke="#001529" StrokeThickness="2"/>
                            <!-- Icon/Box -->
                            <Border Canvas.Top="55" Canvas.Left="0" Width="40" Height="40" Background="#F0F5FF" BorderBrush="#ADC6FF" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="🏅" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <StackPanel Canvas.Top="55" Canvas.Left="50" Width="200">
                                <TextBlock Text="Huân chương Chiến công hạng 3" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="Nhận chương huyền Huân chương Chiến công hạng 3" TextWrapping="Wrap" Foreground="#666666" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Canvas>

                        <!-- Item 3 -->
                        <Canvas Margin="650,0,0,0">
                            <TextBlock Text="01/05/2023" Canvas.Top="5" Foreground="#666666"/>
                            <Line X1="35" Y1="30" X2="35" Y2="50" Stroke="#001529" StrokeThickness="2"/>
                            <!-- Icon/Box -->
                            <Border Canvas.Top="55" Canvas.Left="0" Width="40" Height="40" Background="#FFF1F0" BorderBrush="#FFA39E" BorderThickness="1" CornerRadius="4">
                                <TextBlock Text="⭐" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                            </Border>
                            <StackPanel Canvas.Top="55" Canvas.Left="50" Width="250">
                                <TextBlock Text="Đề cử Huân chương Chiến sĩ vẻ vang" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="Đề cử Huân chương Chiến sĩ vẻ vang bỏ đầy sử Huân chương Chiến công nguyên khiên chiến sĩ" TextWrapping="Wrap" Foreground="#666666" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Canvas>

                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
