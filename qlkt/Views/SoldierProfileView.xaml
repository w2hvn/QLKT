<UserControl x:Class="QLKT.Views.SoldierProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                <RowDefinition Height="Auto"/> <!-- Cards -->
                <RowDefinition Height="*"/>    <!-- Timeline -->
            </Grid.RowDefinitions>

            <!-- SEARCH & FILTER SECTION -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#E8E8E8" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Tìm kiếm chiến sĩ" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox x:Name="txtSearch" Height="36" VerticalContentAlignment="Center" Padding="30,0,10,0" TextChanged="txtSearch_TextChanged"/>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" Foreground="#999"/>
                            <TextBlock x:Name="txtSearchHint" Text="Nhập tên hoặc mã SQ..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="32,0" Foreground="#999" IsHitTestVisible="False"/>

                            <!-- Results Popup -->
                            <Popup x:Name="popResults" IsOpen="False" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=txtSearch}" Width="{Binding ElementName=txtSearch, Path=ActualWidth}">
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" MaxHeight="250">
                                    <ListBox x:Name="lstResults" BorderThickness="0" SelectionChanged="lstResults_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding SoldierCode}" FontSize="11" Foreground="#666" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding UnitName}" FontSize="11" Foreground="#666"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Đơn vị" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboUnit" Height="36" DisplayMemberPath="UnitName" SelectedValuePath="UnitID" SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Chức vụ" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboPosition" Height="36" SelectionChanged="Filter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Quân hàm" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cboRank" Height="36" SelectionChanged="Filter_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Top Cards Section -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Card -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="0,0,0,20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Top Background Color -->
                        <Border Height="100" Background="#001529" CornerRadius="8,8,0,0"/>
                        <!-- Avatar -->
                        <Border Width="120" Height="120" CornerRadius="60" Margin="0,-60,0,10" Background="White" BorderBrush="White" BorderThickness="4">
                            <Ellipse Width="112" Height="112">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#E0E0E0"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <TextBlock Text="👨‍✈️" FontSize="50" HorizontalAlignment="Center" Margin="0,-115,0,50" Foreground="Gray" RenderTransformOrigin="0.5,0.5"/>

                        <TextBlock x:Name="txtFullName" Text="Chọn chiến sĩ..." FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                        <TextBlock x:Name="txtRankDisplay" Text="---" FontSize="16" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Info Card -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Thông tin cá nhân" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã SQ" Foreground="#666666"/>
                            <TextBlock x:Name="txtSoldierCode" Grid.Column="1" Text="---" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Dân tộc" Foreground="#666666"/>
                            <TextBlock x:Name="txtEthnicity" Grid.Column="1" Text="---" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tôn giáo" Foreground="#666666"/>
                            <TextBlock x:Name="txtReligion" Grid.Column="1" Text="---" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rank & Unit Card -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cấp bậc &amp; Đơn vị" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                        <TextBlock Text="Cấp bậc hiện tại" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtRankDetail" Text="---" Margin="0,0,0,12"/>

                        <TextBlock Text="Đơn vị" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtUnitDetail" Text="---" Margin="0,0,0,12"/>

                        <TextBlock Text="Chức vụ" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtPosition" Text="---"/>
                    </StackPanel>
                </Border>

                <!-- Achievements Card -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Margin="0,0,16,16" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Thành tích tiêu biểu" FontWeight="Bold" FontSize="16"/>
                        </Grid>
                        <StackPanel x:Name="pnlTopAchievements">
                             <TextBlock Text="Chưa có thông tin khen thưởng." Foreground="#999" FontStyle="Italic"/>
                        </StackPanel>
                        <Button x:Name="btnCreateProposal" Content="TẠO ĐỀ XUẤT" Click="BtnCreateProposal_Click" Style="{StaticResource Button}" Tag="Primary" Height="36" Margin="0,10,0,0" IsEnabled="False"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Timeline Section -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="24" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Timeline Khen thưởng" FontWeight="Bold" FontSize="16" Margin="0,0,0,30"/>

                    <ItemsControl x:Name="icTimeline">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Date}" VerticalAlignment="Center" Foreground="#666"/>

                                    <Ellipse Grid.Column="1" Width="12" Height="12" Fill="#001529" Margin="10,0"/>

                                    <Border Grid.Column="2" Background="#F8F9FA" CornerRadius="4" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Reason}" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="txtNoTimeline" Text="Không có lịch sử khen thưởng." Foreground="#999" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
