<UserControl x:Class="QLKT.Views.RewardManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT PANEL: CREATE PROPOSAL ================= -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="TẠO MỚI ĐỀ XUẤT" Style="{StaticResource Text.Heading.Small}" Margin="0,0,0,20"/>

                <!-- Soldier Search -->
                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Chiến sĩ được đề xuất" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <TextBox x:Name="txtSearchSoldier" TextChanged="txtSearchSoldier_TextChanged"/>
                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Text="Tìm kiếm đề xuất/chiến sĩ..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0" IsHitTestVisible="False" Foreground="{StaticResource Brush.Text.Muted}" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reward Type -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Loại khen thưởng" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cboType">
                            <ComboBoxItem Content="Huân chương Chiến công"/>
                            <ComboBoxItem Content="Bằng khen"/>
                            <ComboBoxItem Content="Huân chương bồn"/>
                            <ComboBoxItem Content="Loại khen thưởng"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Rank (Auto-filled) -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Cấp bậc hiện tại" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtRank" IsReadOnly="True" Background="#F0F2F5"/>
                    </StackPanel>
                </Grid>

                <!-- Reason -->
                <TextBlock Text="Lý do đề xuất" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                <TextBox x:Name="txtReason" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Ngày đề xuất" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <DatePicker x:Name="dpDate"/>
                    </StackPanel>

                    <!-- Unit (Auto-filled) -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Đơn vị" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtUnit" IsReadOnly="True" Background="#F0F2F5"/>
                    </StackPanel>
                </Grid>

                <!-- Attachments -->
                <TextBlock Text="Tệp đính kèm" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📤" Margin="0,0,10,0"/>
                        <TextBlock Text="Tệp đính kèm" Foreground="{StaticResource Brush.Text.Secondary}"/>
                    </StackPanel>
                </Border>

                <!-- Action Button -->
                <Button Content="GỬI ĐỀ XUẤT" Style="{StaticResource Button}" Tag="Dark" Height="45" FontSize="14" Click="Add_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= RIGHT PANEL: APPROVAL ================= -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
            <StackPanel>
                <TextBlock Text="PHÊ DUYỆT ĐỀ XUẤT" Style="{StaticResource Text.Heading.Small}" Margin="0,0,0,20"/>

                <!-- List of proposals -->
                <DataGrid x:Name="dgRewards" Style="{StaticResource DataGrid}" Height="200" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgRewards_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding RewardID}" Width="60"/>
                        <DataGridTextColumn Header="Tên Chiến sĩ" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding RewardType}" Width="150"/>
                        <DataGridTextColumn Header="Ngày đề xuất" Binding="{Binding DateSigned, StringFormat=d}" Width="120"/>
                        <DataGridTemplateColumn Header="Trạng thái" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="PHÊ DUYỆT" Style="{StaticResource Button}" Tag="Success" FontSize="10" Padding="8,4" Margin="0,0,4,0"/>
                                        <Button Content="TỪ CHỐI" Style="{StaticResource Button}" Tag="Danger" FontSize="10" Padding="8,4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Ý KIẾN NGƯỜI PHÊ DUYỆT" Style="{StaticResource Text.Label}" Margin="0,20,0,8"/>
                <!-- Rich text editor placeholder -->
                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Background="White">
                    <StackPanel>
                        <Border Background="#FAFAFA" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="B I U S" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="🔗 📋 🖼️" Margin="10,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBox Height="100" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Người phê duyệt" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cboApprover">
                            <ComboBoxItem Content="Lt. Col. Nguyễn Văn Hùng"/>
                            <ComboBoxItem Content="Lt. Nguyễn Việt Nam"/>
                            <ComboBoxItem Content="Đặng Văn Tú, Trung tá"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Cập nhật trạng thái" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="cboStatus">
                            <ComboBoxItem Content="Đã phê duyệt"/>
                            <ComboBoxItem Content="Từ chối"/>
                            <ComboBoxItem Content="Yêu cầu bổ sung"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Stats summary footer -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Đã phê duyệt: " Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="12" Foreground="{StaticResource Brush.Success}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Đang chờ: " Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="5" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Từ chối: " Foreground="{StaticResource Brush.Text.Secondary}"/>
                            <TextBlock Text="2" Foreground="{StaticResource Brush.Danger}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
