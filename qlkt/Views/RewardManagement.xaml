<UserControl x:Class="QLKT.Views.RewardManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Soldier List -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="txtSearchSoldier" Margin="0,0,0,10" TextChanged="txtSearchSoldier_TextChanged" 
                     Text="Nhập tên tìm kiếm..."/>
            <ListBox x:Name="lstSoldiers" Grid.Row="1" DisplayMemberPath="FullName" 
                     SelectionChanged="lstSoldiers_SelectionChanged"/>
        </Grid>

        <!-- Right: Rewards -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Reward History -->
            <GroupBox Header="Lịch sử khen thưởng" Grid.Row="0">
                <DataGrid x:Name="dgRewards" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionChanged="dgRewards_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Số QĐ" Binding="{Binding DecisionNumber}"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding RewardType}"/>
                        <DataGridTextColumn Header="Ngày ký" Binding="{Binding DateSigned, StringFormat=d}"/>
                        <DataGridTextColumn Header="Lý do" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Reward Form -->
            <GroupBox Header="Thông tin quyết định" Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Số quyết định:"/>
                    <TextBox x:Name="txtDecision"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Loại khen thưởng:"/>
                            <ComboBox x:Name="cboType" Margin="0,5">
                                <ComboBoxItem Content="Huân chương"/>
                                <ComboBoxItem Content="Huy chương"/>
                                <ComboBoxItem Content="Bằng khen"/>
                                <ComboBoxItem Content="Giấy khen"/>
                                <ComboBoxItem Content="Danh hiệu thi đua"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Ngày ký:"/>
                            <DatePicker x:Name="dpDate" Margin="0,5"/>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Text="Lý do / Nội dung:"/>
                    <TextBox x:Name="txtReason" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Thêm mới" Click="Add_Click" Margin="0,0,10,0" Width="80"/>
                        <Button Content="Cập nhật" Click="Update_Click" Margin="0,0,10,0" Width="80"/>
                        <Button Content="Xóa" Click="Delete_Click" Background="Red" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
