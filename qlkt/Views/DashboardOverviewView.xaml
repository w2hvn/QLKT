<UserControl x:Class="QLKT.Views.DashboardOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <!-- Filters -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20" BorderBrush="#E8E8E8" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Năm:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboYear" Width="120" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="2023" IsSelected="True"/>
                                <ComboBoxItem Content="2022"/>
                                <ComboBoxItem Content="2021"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Đơn vị:" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cboUnit" Width="200" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Tất cả đơn vị" IsSelected="True"/>
                                <ComboBoxItem Content="Sư đoàn 301"/>
                                <ComboBoxItem Content="Sư đoàn 324"/>
                                <ComboBoxItem Content="Quân đoàn 1"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Làm mới dữ liệu" Style="{StaticResource Button}" VerticalAlignment="Bottom" Height="36" Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Border>

                <!-- KPI Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="30" Background="#FFF7E6" Margin="0,0,15,0">
                                <TextBlock Text="⭐" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FAAD14"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TỔNG SỐ CHIẾN SĨ ĐƯỢC&#x0a;KHEN THƯỞNG" FontWeight="Bold" Foreground="#333333" FontSize="12"/>
                                <TextBlock Text="18,745" FontWeight="Bold" FontSize="28" Foreground="#001529" Margin="0,5,0,0"/>
                                <TextBlock Text="+2.1% so với tháng trước" Foreground="#52C41A" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="30" Background="#F0F5FF" Margin="0,0,15,0">
                                <TextBlock Text="⚠️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1890FF"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PHÊ DUYỆT ĐANG CHỜ" FontWeight="Bold" Foreground="#333333" FontSize="12"/>
                                <TextBlock Text="143" FontWeight="Bold" FontSize="28" Foreground="#001529" Margin="0,5,0,0"/>
                                <TextBlock Text="Đang chờ xử lý" Foreground="#666666" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3 -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="60" Height="60" CornerRadius="30" Background="#FFF1F0" Margin="0,0,15,0">
                                <TextBlock Text="🏅" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F5222D"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="DANH MỤC KHEN THƯỞNG" FontWeight="Bold" Foreground="#333333" FontSize="12"/>
                                <TextBlock Text="45" FontWeight="Bold" FontSize="28" Foreground="#001529" Margin="0,5,0,0"/>
                                <TextBlock Text="Huân chương, Huy chương, v.v." Foreground="#666666" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Charts Row 1 -->
                <Grid Height="350">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chart 1 -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="XU HƯỚNG KHEN THƯỞNG THEO THÁNG" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" LegendPosition="Top"/>
                        </Grid>
                    </Border>

                    <!-- Chart 2 -->
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CƠ CẤU KHEN THƯỞNG THEO LOẠI" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <lvc:PieChart Grid.Row="1" Series="{Binding RewardTypesSeries}" InitialRotation="-90"/>
                        </Grid>
                    </Border>

                    <!-- Chart 3 -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E8E8E8" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="SỐ LƯỢNG KHEN THƯỞNG THEO ĐƠN VỊ" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding TopUnitsSeries}" XAxes="{Binding TopUnitsXAxes}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
