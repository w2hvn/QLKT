<UserControl x:Class="QLKT.Views.DashboardOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Bar -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,16" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Đơn vị" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Border BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="5" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#F0F0F0" CornerRadius="4" Padding="8,4" Margin="0,0,5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sư đoàn 301"/>
                                    <TextBlock Text="×" Margin="5,0,0,0" Foreground="#999" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Sư đoàn 316" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="Sư đoàn 315" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="Sư đoàn 318" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="Sư đoàn 318" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock Text="v" VerticalAlignment="Center" Margin="10,0,5,0" Foreground="#999"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Thời gian" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Border BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="4" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" Margin="0,0,5,0"/>
                            <TextBlock Text="Năm nay (2023)"/>
                            <TextBlock Text="v" Margin="10,0,0,0" Foreground="#999"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Charts Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="350"/>
                    <RowDefinition Height="350"/>
                </Grid.RowDefinitions>

                <!-- Chart 1: Thống kê khen thưởng theo tháng -->
                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,16" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="THỐNG KÊ KHEN THƯỞNG THEO THÁNG (2023)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlyRewardsSeries}" XAxes="{Binding MonthlyRewardsXAxes}" LegendPosition="Top"/>
                    </Grid>
                </Border>

                <!-- Chart 2: Cơ cấu khen thưởng theo loại -->
                <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CƠ CẤU KHEN THƯỞNG THEO LOẠI" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <lvc:PieChart Grid.Row="1" Series="{Binding RewardTypesSeries}" LegendPosition="Right" InitialRotation="-90"/>
                    </Grid>
                </Border>

                <!-- Chart 3: Xu hướng đề xuất và phê duyệt -->
                <Border Grid.Row="1" Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,16,0" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="XU HƯỚNG ĐỀ XUẤT VÀ PHÊ DUYỆT" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" LegendPosition="Top"/>
                    </Grid>
                </Border>

                <!-- Chart 4: Top đơn vị xuất sắc -->
                <Border Grid.Row="1" Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,0" BorderBrush="#E8E8E8" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="TOP ĐƠN VỊ XUẤT SẮC" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding TopUnitsSeries}" YAxes="{Binding TopUnitsYAxes}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
