<Window x:Class="QLKT.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Military Reward App" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="{StaticResource Brush.Primary}" Margin="0,0,0,20"/>
            
            <TextBlock Text="Tên đăng nhập:" Margin="0,5"/>
            <TextBox x:Name="txtUsername" Text="admin"/>
            
            <TextBlock Text="Mật khẩu:" Margin="0,5"/>
            <Grid>
                <PasswordBox x:Name="txtPassword"/>
                <TextBox x:Name="txtPasswordVisible" Visibility="Collapsed"/>
                <ToggleButton x:Name="btnTogglePassword" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnTogglePassword_Click">
                    <TextBlock x:Name="txtEyeIcon" Text="👁️" VerticalAlignment="Center" Margin="0,0,5,0"/>
                </ToggleButton>
            </Grid>
            
            <CheckBox x:Name="chkRememberMe" Content="Duy trì đăng nhập" Margin="0,15"/>

            <TextBlock x:Name="lblError" Foreground="Red" Margin="0,5" Visibility="Collapsed"/>

            <Button HorizontalContentAlignment="Center" Height="30" Content="Đăng Nhập" Style="{StaticResource Button}" Tag="Primary"
                    Click="Login_Click" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
