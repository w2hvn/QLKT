<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">
    

<!-- ================= ELEVATION 0 ================= -->
<!-- No shadow -->
<effects:DropShadowEffect x:Key="Shadow.None"
                              BlurRadius="0"
                              Opacity="0"
                              ShadowDepth="0"/>

<!-- ================= ELEVATION 1 ================= -->
<!-- Card (default) -->
<effects:DropShadowEffect x:Key="Shadow.Level1"
                              BlurRadius="8"
                              Opacity="0.08"
                              ShadowDepth="2"
                              Direction="270"/>

<!-- ================= ELEVATION 2 ================= -->
<!-- Hover / active card -->
<effects:DropShadowEffect x:Key="Shadow.Level2"
                              BlurRadius="12"
                              Opacity="0.12"
                              ShadowDepth="3"
                              Direction="270"/>

<!-- ================= ELEVATION 3 ================= -->
<!-- Popup / dropdown -->
<effects:DropShadowEffect x:Key="Shadow.Level3"
                              BlurRadius="16"
                              Opacity="0.16"
                              ShadowDepth="4"
                              Direction="270"/>

<!-- ================= ELEVATION 4 ================= -->
<!-- Modal / overlay -->
<effects:DropShadowEffect x:Key="Shadow.Level4"
                              BlurRadius="24"
                              Opacity="0.20"
                              ShadowDepth="6"
                              Direction="270"/>

</ResourceDictionary>
