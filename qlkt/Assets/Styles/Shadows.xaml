<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore">

    <effects:DropShadowEffect x:Key="Shadow.None"
                              BlurRadius="0"
                              Opacity="0"
                              ShadowDepth="0"/>

    <effects:DropShadowEffect x:Key="Shadow.Level1"
                              BlurRadius="10"
                              Opacity="0.05"
                              ShadowDepth="1"
                              Direction="270"/>

    <effects:DropShadowEffect x:Key="Shadow.Level2"
                              BlurRadius="15"
                              Opacity="0.1"
                              ShadowDepth="2"
                              Direction="270"/>

    <effects:DropShadowEffect x:Key="Shadow.Level3"
                              BlurRadius="20"
                              Opacity="0.15"
                              ShadowDepth="4"
                              Direction="270"/>

</ResourceDictionary>
