<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource Card.Padding}"/>
        <Setter Property="Margin" Value="{StaticResource Card.Margin}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Level1}"/>
    </Style>

    <Style x:Key="Card.KPI" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MinWidth" Value="240"/>
        <Setter Property="Height" Value="100"/>
    </Style>

</ResourceDictionary>
