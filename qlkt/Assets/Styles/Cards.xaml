<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= BASE CARD ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="{StaticResource Card.Padding}"/>
        <Setter Property="Margin" Value="{StaticResource Card.Margin}"/>
        <Setter Property="Effect" Value="{StaticResource Shadow.Level1}"/>
    </Style>

    <!-- ================= CARD WITH HOVER ================= -->
    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Cursor" Value="Hand"/>

        <Style.Triggers>

            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource Shadow.Level2}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Surface.Hover}"/>
            </Trigger>

        </Style.Triggers>
    </Style>

    <!-- ================= CARD KPI (Dashboard) ================= -->
    <Style x:Key="Card.KPI" TargetType="Border" BasedOn="{StaticResource Card.Interactive}">
        <Setter Property="Width" Value="280"/>
        <Setter Property="Height" Value="120"/>
    </Style>

    <!-- ================= CARD CONTAINER (NO PADDING) ================= -->
    <Style x:Key="Card.Container" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ================= CARD HEADER ================= -->
    <Style x:Key="Card.Header" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ================= CARD BODY ================= -->
    <Style x:Key="Card.Body" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ================= CARD FOOTER ================= -->
    <Style x:Key="Card.Footer" TargetType="Border">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
    </Style>

</ResourceDictionary>